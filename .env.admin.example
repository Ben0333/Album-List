# Copy to .env.admin on the host that runs the private admin service.
# Never commit the real .env.admin file.

# Use either ADMIN_TOKEN or ADMIN_PASSWORD_HASH.
# Token smoke-test auth:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# Password login auth. Keep bcrypt hashes single-quoted because they contain `$`
# characters, and Docker Compose interpolates unquoted env values.
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "replace-with-a-long-admin-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''

ADMIN_PORT=3001
ADMIN_HOST=127.0.0.1
# Keep this on the localhost origin used by the SSH tunnel.
ADMIN_ORIGIN=http://127.0.0.1:3001
ADMIN_SESSION_COOKIE_NAME=albums_admin_sid
ADMIN_SESSION_DAYS=1
ADMIN_COOKIE_SECURE=false
