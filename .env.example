# Required for production:
# NODE_ENV=production
# APP_ORIGIN=https://albums.example.com
# COOKIE_SECURE=true
# DATABASE_PATH=/data/albums.sqlite
# TRUST_PROXY=true

NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=albums_sid
SESSION_DAYS=30
COOKIE_SECURE=false
DATABASE_PATH=./data/albums.sqlite
TRUST_PROXY=false
METADATA_WORKER_ENABLED=true
METADATA_WORKER_POLL_MS=1500
METADATA_WORKER_CONCURRENCY=1
LOCAL_COVER_CACHE_DIR=./data/covers
MAX_LOCAL_COVER_IMAGES=5000
MAX_LOCAL_COVER_BYTES=12000000000
METADATA_JOB_MAX_ATTEMPTS=5
METADATA_JOB_SUCCESS_RETENTION_DAYS=14
SEARCH_CACHE_TTL_HOURS=24
SEARCH_CACHE_MAX_ROWS=10000
COVER_PROBE_SUCCESS_TTL_HOURS=168
COVER_PROBE_FAILURE_TTL_HOURS=12
COVER_PROBE_MAX_ROWS=50000
COVER_LOOKUP_FAILURE_BASE_MINUTES=60
COVER_LOOKUP_FAILURE_MAX_HOURS=168
