NODE_ENV=development
PORT=3000
ADMIN_PORT=3001
ADMIN_HOST=127.0.0.1
CLOUDFLARED_SERVICE_NAME=Cloudflared
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=albums_sid
SESSION_DAYS=30
COOKIE_SECURE=false
DATABASE_PATH=./data/albums.sqlite
TRUST_PROXY=false

