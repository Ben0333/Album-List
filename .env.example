# Required for production:
# NODE_ENV=production
# APP_ORIGIN=https://albums.example.com
# COOKIE_SECURE=true
# DATABASE_PATH=/data/albums.sqlite
# TRUST_PROXY=true

NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=albums_sid
SESSION_DAYS=30
COOKIE_SECURE=false
DATABASE_PATH=./data/albums.sqlite
TRUST_PROXY=false
