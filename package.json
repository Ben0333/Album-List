{
  "name": "albums-to-listen-to",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Album list web app with accounts, sharing, collaboration, and ratings.",
  "workspaces": [
    "admin",
    "server",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @albums/server\" \"npm run dev -w @albums/web\"",
    "dev:admin": "npm run dev -w @albums/admin",
    "dev:server": "npm run dev -w @albums/server",
    "dev:web": "npm run dev -w @albums/web",
    "build": "npm run build -w @albums/web",
    "start": "npm run start -w @albums/server",
    "start:admin": "npm run start -w @albums/admin",
    "check": "npm run check -w @albums/server && npm run check -w @albums/admin && npm run check -w @albums/web",
    "audit": "npm audit --omit=dev",
    "db:backup": "node scripts/backup-db.js",
    "stress:local": "node scripts/stress/write-load.js",
    "stress:target": "node scripts/stress/write-load.js --target-required",
    "smoke:target": "node scripts/stress/write-load.js --target-required --smoke",
    "stress:cleanup": "node scripts/stress/cleanup-load-data.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
